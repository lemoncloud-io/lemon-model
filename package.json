{
  "name": "lemon-model",
  "version": "5.0.2",
  "description": "Common shared model definitions for Lemon Micro-Service Platform",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./genai/testing": {
      "types": "./dist/genai/testing.d.ts",
      "import": "./dist/esm/genai/testing.js",
      "require": "./dist/genai/testing.js",
      "default": "./dist/genai/testing.js"
    },
    "./buffer/testing": {
      "types": "./dist/buffer/testing.d.ts",
      "import": "./dist/esm/buffer/testing.js",
      "require": "./dist/buffer/testing.js",
      "default": "./dist/buffer/testing.js"
    },
    "./progress/testing": {
      "types": "./dist/progress/testing.d.ts",
      "import": "./dist/esm/progress/testing.js",
      "require": "./dist/progress/testing.js",
      "default": "./dist/progress/testing.js"
    },
    "./socket/testing": {
      "types": "./dist/socket/testing.d.ts",
      "import": "./dist/esm/socket/testing.js",
      "require": "./dist/socket/testing.js",
      "default": "./dist/socket/testing.js"
    },
    "./logtrace/testing": {
      "types": "./dist/logtrace/testing.d.ts",
      "import": "./dist/esm/logtrace/testing.js",
      "require": "./dist/logtrace/testing.js",
      "default": "./dist/logtrace/testing.js"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "import": "./dist/esm/upload/index.js",
      "require": "./dist/upload/index.js",
      "default": "./dist/upload/index.js"
    },
    "./upload/testing": {
      "types": "./dist/upload/testing.d.ts",
      "import": "./dist/esm/upload/testing.js",
      "require": "./dist/upload/testing.js",
      "default": "./dist/upload/testing.js"
    },
    "./upload/engine": {
      "types": "./dist/upload/engine/index.d.ts",
      "import": "./dist/esm/upload/engine/index.js",
      "require": "./dist/upload/engine/index.js",
      "default": "./dist/upload/engine/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "upload": ["dist/upload/index.d.ts"],
      "upload/testing": ["dist/upload/testing.d.ts"],
      "upload/engine": ["dist/upload/engine/index.d.ts"]
    }
  },
  "scripts": {
    "build": "npm run build-ts && npm run build-esm",
    "build-ts": "tsc -v && tsc",
    "build-esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-build.cjs",
    "watch-ts": "tsc -w",
    "lint": "tsc --noEmit && eslint '*/**/*.{js,ts,jsx,tsx}' --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "!test": "------- run self-test with jest -----",
    "test": "jest --config=jest.config.json",
    "test:package-exports": "npm run build && node scripts/check-package-exports.cjs",
    "test:watch": "jest --config=jest.config.json --watchAll",
    "!publish": "------- publish into repository -----",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint && npm run format"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "author": "Steve Jung <steve@lemoncloud.io>",
  "license": "MIT",
  "devDependencies": {
    "@types/async": "^3.2.3",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.7",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^3.12.5",
    "@types/mime-types": "^2.1.0",
    "@types/supertest": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^5.15.0",
    "@typescript-eslint/parser": "^5.15.0",
    "deepmerge": "file:./scripts/deepmerge-safe",
    "eslint": "^8.11.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.7.0",
    "prettier": "^2.6.0",
    "superagent": "^5.3.1",
    "supertest": "^4.0.2",
    "ts-jest": "^29.4.15",
    "typescript": "^4.6.2"
  },
  "overrides": {
    "deepmerge": "$deepmerge"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lemoncloud-io/lemon-model.git"
  },
  "keywords": [
    "lemoncloud",
    "lemon-model",
    "CoreModel"
  ],
  "bugs": {
    "url": "https://github.com/lemoncloud-io/lemon-model/issues"
  },
  "homepage": "https://github.com/lemoncloud-io/lemon-model#readme"
}
